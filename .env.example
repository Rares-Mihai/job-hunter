# Postgres connection string.
# Local database started with `docker compose up -d`:
DATABASE_URL="postgres://jobhunter:jobhunter@localhost:5432/jobhunter"

# --- Sign-in with GitHub ---
# Any long random text; it signs the session cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The address the app runs at.
BETTER_AUTH_URL="http://localhost:3000"
# From a GitHub OAuth app (the README explains how to create one).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- AI features ---
# Claude API key for the AI features (job analysis and CV match).
# Create one at https://console.anthropic.com/ . The app works without it,
# but the two AI buttons will say that AI is not set up.
ANTHROPIC_API_KEY=""

# Optional: which Claude model the AI features use.
# ANTHROPIC_MODEL="claude-haiku-5-5"

# Optional: daily limits on AI requests, to keep the API bill bounded.
# AI_DAILY_LIMIT_PER_USER="20"
# AI_DAILY_LIMIT_TOTAL="200"
