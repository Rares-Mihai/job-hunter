# Postgres connection string.
# Local database started with `docker compose up -d`:
DATABASE_URL="postgres://jobhunter:jobhunter@localhost:5432/jobhunter"

# Claude API key for the AI features (job analysis and CV match).
# Create one at https://console.anthropic.com/ . The app works without it,
# but the two AI buttons will say that AI is not set up.
ANTHROPIC_API_KEY=""

# Optional: which Claude model the AI features use.
# ANTHROPIC_MODEL="claude-haiku-5-5"
